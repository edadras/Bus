###############################################################################
# Application
###############################################################################
APP_NAME="همسفر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Persian is the product default; English is available via ?lang=en.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hamsafar
DB_USERNAME=hamsafar
DB_PASSWORD=secret

###############################################################################
# Cache, queue, session
#
# Redis is not optional in production: the live bus state, the QR replay
# window and the rate limiters all live there. With the array/file driver the
# platform still runs, but replay protection stops working across processes.
###############################################################################
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Broadcasting — Laravel Reverb
###############################################################################
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=hamsafar
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

###############################################################################
# Filesystem
###############################################################################
FILESYSTEM_DISK=local

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Transit platform
###############################################################################
TRANSIT_DEFAULT_CITY=bandar-abbas

# GPS ingest
TRANSIT_GPS_MIN_INTERVAL=3
TRANSIT_GPS_MAX_ACCURACY=100
TRANSIT_GPS_MAX_SPEED=140
TRANSIT_GPS_OFF_ROUTE=150
TRANSIT_STOP_GEOFENCE=60
TRANSIT_GPS_RETENTION_DAYS=30

# ETA engine
TRANSIT_ETA_BASELINE_SPEED=22

# Rotating QR tokens
TRANSIT_QR_ROTATION=30

# Leave unset in production so a real code is required. When set (and outside
# production) this fixed code is accepted, which is how the automated tests and
# a local install work without an SMS gateway.
OTP_TESTING_CODE=

###############################################################################
# Wallet
#
# Amounts are integer minor units (rial). The UI displays Toman.
###############################################################################
WALLET_CURRENCY=IRR
WALLET_DISPLAY_UNIT=toman
PAYMENT_GATEWAY=sandbox
MERCHANT_COMMISSION_BPS=150

###############################################################################
# Mapping — swap the provider without touching any client
###############################################################################
MAP_PROVIDER=osm
MAP_DEFAULT_LAT=27.1832
MAP_DEFAULT_LNG=56.2666
MAP_DEFAULT_ZOOM=12

# MAP_MAPBOX_TILE_URL=
# MAP_MAPBOX_TOKEN=
# MAP_NESHAN_TILE_URL=
# MAP_NESHAN_TOKEN=

###############################################################################
# Frontend build
###############################################################################
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
